<!-- Vi bruker Aspire-SDK-en på linje 1 slik at stiene til dcp og dashboard blir funnet automatisk -->
<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Siden du ikke ønsker den globale CLI-en, tvinger vi NuGet-modus og skjuler ASPIRE010 -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinyDrone.WebApi\TinyDrone.WebApi.csproj" OutputItemType="AspireProjectMetadata" />
  </ItemGroup>

</Project>
